{"title": "LSF HPC 集群总览", "uid": "lsf-hpc-overview", "tags": ["lsf", "hpc"], "timezone": "browser", "refresh": "30s", "time": {"from": "now-1h", "to": "now"}, "panels": [{"type": "stat", "title": "集群总槽位", "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0}, "targets": [{"expr": "lsf_slots_max"}]}, {"type": "stat", "title": "已用槽位", "gridPos": {"h": 4, "w": 3, "x": 3, "y": 0}, "targets": [{"expr": "lsf_slots_busy"}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 32}, {"color": "red", "value": 44}]}}}}, {"type": "stat", "title": "节点数", "gridPos": {"h": 4, "w": 3, "x": 6, "y": 0}, "targets": [{"expr": "lsf_hosts_total"}]}, {"type": "stat", "title": "运行中作业", "gridPos": {"h": 4, "w": 3, "x": 9, "y": 0}, "targets": [{"expr": "lsf_jobs_state{stat=\"RUN\"}"}]}, {"type": "stat", "title": "排队作业", "gridPos": {"h": 4, "w": 3, "x": 12, "y": 0}, "targets": [{"expr": "lsf_jobs_state{stat=\"PEND\"}"}]}, {"type": "stat", "title": "节点健康 (ok数)", "gridPos": {"h": 4, "w": 3, "x": 15, "y": 0}, "targets": [{"expr": "sum(lsf_host_status_ok)"}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 5}]}}}}, {"type": "stat", "title": "24h 完成作业", "gridPos": {"h": 4, "w": 3, "x": 18, "y": 0}, "targets": [{"expr": "lsf_jobs_done_24h"}]}, {"type": "timeseries", "title": "作业状态趋势", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"expr": "lsf_jobs_state", "legendFormat": "{{stat}}"}]}, {"type": "timeseries", "title": "槽位使用趋势", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"expr": "lsf_slots_max", "legendFormat": "max"}, {"expr": "lsf_slots_busy", "legendFormat": "busy"}]}, {"type": "timeseries", "title": "节点 CPU 使用率", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "{{instance}}"}]}, {"type": "timeseries", "title": "节点内存使用率", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "targets": [{"expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "{{instance}}"}]}, {"type": "timeseries", "title": "网络流量 (接收)", "gridPos": {"h": 8, "w": 6, "x": 0, "y": 20}, "targets": [{"expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[2m])", "legendFormat": "{{instance}} {{device}}"}]}, {"type": "timeseries", "title": "网络流量 (发送)", "gridPos": {"h": 8, "w": 6, "x": 6, "y": 20}, "targets": [{"expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[2m])", "legendFormat": "{{instance}} {{device}}"}]}, {"type": "bargauge", "title": "各节点槽位占用", "gridPos": {"h": 8, "w": 6, "x": 12, "y": 20}, "targets": [{"expr": "lsf_host_slots_busy", "legendFormat": "{{host}}"}]}, {"type": "timeseries", "title": "节点磁盘 IO", "gridPos": {"h": 8, "w": 6, "x": 18, "y": 20}, "targets": [{"expr": "rate(node_disk_read_bytes_total[2m])", "legendFormat": "{{instance}} read"}, {"expr": "rate(node_disk_written_bytes_total[2m])", "legendFormat": "{{instance}} write"}]}, {"type": "stat", "title": "历史完成作业", "gridPos": {"h": 4, "w": 3, "x": 21, "y": 0}, "targets": [{"expr": "max_over_time(lsf_jobs_state{stat=\"DONE\"}[8760h])", "refId": "A"}], "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}, "noValue": "0"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "textMode": "value"}}], "schemaVersion": 39, "version": 1}